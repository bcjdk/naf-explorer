  "narrative": {
    "northStar": "The Annotated Blueprint",
    "overview": "One fixed 1440x952 stage holds seven neutral dark regions that never move. Everything on it is a document: a card, a label, a line. The only loud thing is provenance colour, the NAF block colours, spent narrowly so the eye can follow who made what.",
    "keyCharacteristics": [
      "Neutral dark canvas; colour is provenance only.",
      "Fixed stage geometry, hard-coded per scenario (layout.ts).",
      "Status is always icon + word, in neutral or non-provenance styling.",
      "Hover and press are neutral and instant; all motion lives in ui/motion.ts.",
      "Type is one humanist sans with a monospace only for payloads and node names."
    ],
    "rules": [
      {
        "name": "The Provenance-Only Rule",
        "body": "Colour means who produced a thing, and nothing else: region edge + swatch, new-card band/tint/border, touched-card edge, handoff and work lines and arrowheads, label swatch, inspector identity header and edges. Never text, status, selection, focus or activity.",
        "section": "colors"
      },
      {
        "name": "The Status Rule",
        "body": "Chips carry a glyph and the word; never a provenance colour, never colour alone.",
        "section": "colors"
      },
      {
        "name": "The Band Text Rule",
        "body": "Dark text on light bands, white on Executor and The Network.",
        "section": "colors"
      },
      {
        "name": "The Smaller-Card Rule",
        "body": "Card type is 13.5 / 12 / 11.5; the inspector carries the reading size. Nothing below 11px.",
        "section": "typography"
      },
      {
        "name": "The Instant Neutral Rule",
        "body": "Hover and press are neutral and instant, with no transitions, and never touch the provenance edge.",
        "section": "elevation"
      },
      {
        "name": "The One Motion File Rule",
        "body": "All animation lives in ui/motion.ts; CSS declares end states only.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use a provenance colour only on edges, swatches, bands, tints, borders, lines and arrowheads.",
      "Do write status as glyph + word and keep it out of the provenance palette.",
      "Do keep selection (dashed ring), focus (solid white ring), activity (lifted panel) and gain (inset shadow) distinct.",
      "Do keep hover and press neutral and instant; put motion in ui/motion.ts.",
      "Do check text on bands for AA (white on Executor #5b5ede and Network)."
    ],
    "donts": [
      "Don't colour a run of text, a status or a selection with a provenance colour.",
      "Don't tint regions; they stay neutral, with only the 4px edge and swatch.",
      "Don't add canvas Does/Does-not intros or surface subtitles; the inspector explains.",
      "Don't add neon, glassmorphism, NOC-wall styling or decorative motion.",
      "Don't add CSS transitions or keyframes outside ui/motion.ts."
    ]
  }
